{
  "name": "use-signalr",
  "version": "1.0.0",
  "description": "React hook for managing Microsoft SignalR connections with reconects and correct cancel",
  "type": "module",
  "author": "frimko",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "signalr",
    "react",
    "reconnect",
    "correct cancel",
    "hook"
  ],
  "homepage": "https://github.com/Frimko/useSignalr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frimko/useSignalr.git"
  },
  "readme": "./README.md",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build --config tools/vite/vite.config.ts",
    "prepack:build": "tsx tools/build/index.ts",
    "prepack": "yarn prepack:build && tsx tools/prepack.ts",
    "publish": "tsx tools/publish.ts",
    "test": "vitest run --config tools/vite/vitest.config.ts",
    "lint:fix": "eslint src --cache --fix",
    "lint": "eslint src --cache",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "react": "19.3.1",
    "@microsoft/signalr": "10.0.11",
    "@babel/core": "7.29.7",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.1.2",
    "chalk": "4.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.1.3",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.5",
    "react-dom": "19.3.1",
    "tsx": "4.19.2",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.0.8"
  }
}
